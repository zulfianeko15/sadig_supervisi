{
  "entities": {
    "AdminMarker": {
      "title": "Admin Marker",
      "description": "Marks an authenticated Firebase user as an administrator for SADIG.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated user profile and assigned RBAC role in SADIG.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "username": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_.-]+$" },
        "nama": { "type": "string", "minLength": 2, "maxLength": 150 },
        "role": { "type": "string", "enum": ["Admin", "Pengawas Sekolah", "Kepala Sekolah", "Pengawas Supervisi", "Guru"] },
        "nip": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "username", "nama", "role", "nip", "createdAt", "updatedAt"]
    },
    "DirectoryAccount": {
      "title": "School Account Directory Entry",
      "description": "School user roster managed by Admin for assigning roles and supervisors.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "password": { "type": "string", "minLength": 1, "maxLength": 64 },
        "email": { "type": "string", "maxLength": 200 },
        "nama": { "type": "string", "minLength": 2, "maxLength": 150 },
        "role": { "type": "string", "enum": ["Admin", "Pengawas Sekolah", "Kepala Sekolah", "Pengawas Supervisi", "Guru"] },
        "nip": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "password", "email", "nama", "role", "nip", "ownerUid", "createdAt", "updatedAt"]
    },
    "GuruRecord": {
      "title": "Guru Record",
      "description": "Teacher supervision record including Drive link and Kepala Sekolah approval status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nip": { "type": "string", "minLength": 3, "maxLength": 40 },
        "namaGuru": { "type": "string", "minLength": 2, "maxLength": 150 },
        "mataPelajaran": { "type": "string", "minLength": 2, "maxLength": 100 },
        "tanggalPelaksanaan": { "type": "string", "maxLength": 20 },
        "supervisor": { "type": "string", "maxLength": 150 },
        "nipSupervisor": { "type": "string", "maxLength": 40 },
        "statusBerkas": { "type": "string", "enum": ["Belum Dicek", "Disetujui", "Ditolak"] },
        "kelengkapanBerkas": { "type": "string", "enum": ["Ada", "Belum Ada"] },
        "linkDriveBerkas": { "type": "string", "maxLength": 500 },
        "catatanKepsek": { "type": "string", "maxLength": 1000 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guruEmail": { "type": "string", "maxLength": 200 },
        "supervisorEmail": { "type": "string", "maxLength": 200 },
        "kepsekEmail": { "type": "string", "maxLength": 200 },
        "pengawasEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "nip", "namaGuru", "mataPelajaran", "tanggalPelaksanaan", "supervisor",
        "nipSupervisor", "statusBerkas", "kelengkapanBerkas", "linkDriveBerkas",
        "catatanKepsek", "ownerUid", "guruEmail", "supervisorEmail", "kepsekEmail",
        "pengawasEmail", "createdAt", "updatedAt"
      ]
    },
    "AspekItem": {
      "title": "Aspek Penilaian",
      "description": "Supervision indicator item for Persiapan, Pelaksanaan, or Evaluasi.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tahap": { "type": "string", "enum": ["Persiapan", "Pelaksanaan", "Evaluasi"] },
        "kelompok": { "type": "string", "minLength": 1, "maxLength": 150 },
        "aspek": { "type": "string", "minLength": 2, "maxLength": 300 },
        "kategoriDeskripsi": { "type": "string", "maxLength": 1000 },
        "tipePenilaian": { "type": "string", "enum": ["skor", "teks"] },
        "orderIndex": { "type": "number" },
        "publicCatalog": { "type": "boolean" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "tahap", "kelompok", "aspek", "kategoriDeskripsi", "tipePenilaian",
        "orderIndex", "publicCatalog", "ownerUid", "createdAt", "updatedAt"
      ]
    },
    "PenilaianItem": {
      "title": "Penilaian Aspek",
      "description": "Assessment entry for a specific teacher and aspect (1-4 score or Dialog Refleksi text).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guruId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nipGuru": { "type": "string", "minLength": 3, "maxLength": 40 },
        "idAspek": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tahap": { "type": "string", "enum": ["Persiapan", "Pelaksanaan", "Evaluasi"] },
        "skor": { "type": "number" },
        "teksRefleksi": { "type": "string", "maxLength": 3000 },
        "catatan": { "type": "string", "maxLength": 1000 },
        "penilai": { "type": "string", "minLength": 1, "maxLength": 150 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guruEmail": { "type": "string", "maxLength": 200 },
        "supervisorEmail": { "type": "string", "maxLength": 200 },
        "kepsekEmail": { "type": "string", "maxLength": 200 },
        "pengawasEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "guruId", "nipGuru", "idAspek", "tahap", "teksRefleksi", "catatan",
        "penilai", "ownerUid", "guruEmail", "supervisorEmail", "kepsekEmail",
        "pengawasEmail", "createdAt", "updatedAt"
      ]
    },
    "CatatanTahap": {
      "title": "Catatan Tahap Supervisi",
      "description": "Summary notes (Masalah, Pemecahan, Rencana Tindak Lanjut) per teacher and stage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guruId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nipGuru": { "type": "string", "minLength": 3, "maxLength": 40 },
        "tahap": { "type": "string", "enum": ["Persiapan", "Pelaksanaan", "Evaluasi"] },
        "masalah": { "type": "string", "maxLength": 2000 },
        "pemecahan": { "type": "string", "maxLength": 2000 },
        "rencanaTL": { "type": "string", "maxLength": 2000 },
        "penilai": { "type": "string", "maxLength": 150 },
        "updatedAtDate": { "type": "string", "maxLength": 20 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guruEmail": { "type": "string", "maxLength": 200 },
        "supervisorEmail": { "type": "string", "maxLength": 200 },
        "kepsekEmail": { "type": "string", "maxLength": 200 },
        "pengawasEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "guruId", "nipGuru", "tahap", "masalah", "pemecahan", "rencanaTL",
        "penilai", "updatedAtDate", "ownerUid", "guruEmail", "supervisorEmail",
        "kepsekEmail", "pengawasEmail", "createdAt", "updatedAt"
      ]
    },
    "PengaturanSekolah": {
      "title": "Pengaturan Sekolah",
      "description": "School identity, leadership signatures, and custom left/right letterhead logos.",
      "type": "object",
      "properties": {
        "namaSekolah": { "type": "string", "minLength": 2, "maxLength": 200 },
        "dinasPendidikan": { "type": "string", "minLength": 2, "maxLength": 200 },
        "pemerintahDaerah": { "type": "string", "minLength": 2, "maxLength": 200 },
        "alamatSekolah": { "type": "string", "minLength": 2, "maxLength": 300 },
        "tahunPelajaran": { "type": "string", "minLength": 4, "maxLength": 30 },
        "semester": { "type": "string", "minLength": 1, "maxLength": 30 },
        "namaKepalaSekolah": { "type": "string", "minLength": 2, "maxLength": 150 },
        "nipKepalaSekolah": { "type": "string", "maxLength": 40 },
        "namaPengawasSekolah": { "type": "string", "minLength": 2, "maxLength": 150 },
        "nipPengawas": { "type": "string", "maxLength": 40 },
        "tanggalPelaksanaanUmum": { "type": "string", "maxLength": 20 },
        "tempatTanggalCetak": { "type": "string", "maxLength": 120 },
        "logoKiri": { "type": "string", "maxLength": 350000 },
        "logoKanan": { "type": "string", "maxLength": 350000 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "namaSekolah", "dinasPendidikan", "pemerintahDaerah", "alamatSekolah",
        "tahunPelajaran", "semester", "namaKepalaSekolah", "nipKepalaSekolah",
        "namaPengawasSekolah", "nipPengawas", "tanggalPelaksanaanUmum",
        "tempatTanggalCetak", "logoKiri", "logoKanan", "ownerUid", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Administrator privilege markers"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profiles with RBAC role"
    },
    "/directoryUsers/{accountId}": {
      "schema": { "$ref": "#/entities/DirectoryAccount" },
      "description": "School user roster managed by Admin"
    },
    "/guru/{guruId}": {
      "schema": { "$ref": "#/entities/GuruRecord" },
      "description": "Teachers registered for academic supervision"
    },
    "/aspek/{aspekId}": {
      "schema": { "$ref": "#/entities/AspekItem" },
      "description": "Supervision instrument aspects across Persiapan, Pelaksanaan, and Evaluasi"
    },
    "/penilaian/{penilaianId}": {
      "schema": { "$ref": "#/entities/PenilaianItem" },
      "description": "Per-aspect assessment scores and Dialog Refleksi text"
    },
    "/catatanTahap/{catatanId}": {
      "schema": { "$ref": "#/entities/CatatanTahap" },
      "description": "Stage-level Masalah, Pemecahan, and Rencana Tindak Lanjut notes"
    },
    "/pengaturan/{settingId}": {
      "schema": { "$ref": "#/entities/PengaturanSekolah" },
      "description": "School letterhead identity and custom logo settings"
    }
  }
}
